## This version of the Dockerfile show how to keep alpine and dbt working together, but it is not used in production because of the dbt experimental parser issue.


# syntax=docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc

#
# 🎯 Version Management
#
ARG IMAGE="public.ecr.aws/docker/library/eclipse-temurin"
ARG IMAGE_VERSION="21-alpine-3.24"
ARG IMAGE_SHA="6ea5548706b60ac0a602eaf48af74792cbab012d90e811ca8db6184b16b5c3d6"
ARG APPINSIGHTS_VERSION="3.7.9"

# DBT need python 3.12 in order to be installed, because requires a wheels due to dbt's experimental parser.
# It could be removed when the following issue will be resolved: https://github.com/dbt-labs/dbt/issues/15607
ARG PYTHON_VERSION="3.12.16"
ARG PYTHON_SHA256="b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c"

# 🌍 Timezone Configuration
ARG TZ="Europe/Rome"

# 🔧 Build Configuration
ARG GRADLE_OPTS="-Dorg.gradle.daemon=false \
    -Dorg.gradle.parallel=true \
    -Dorg.gradle.caching=true \
    -Dorg.gradle.configureondemand=true \
    -Dorg.gradle.jvmargs=-Xmx2g"

# 👤 App Configuration
ARG APP_USER="appuser"
ARG APP_GROUP="appgroup"
ARG APP_HOME="/app"

#
# 📥 Base Setup Stage
#
FROM ${IMAGE}@sha256:${IMAGE_SHA} AS base
ARG APP_USER
ARG APP_GROUP

# Install base packages
RUN apk add --no-cache \
    wget \
    unzip \
    bash \
    shadow \
    git

# Create user
RUN groupadd --system --gid 1000 ${APP_GROUP} && \
    useradd --system --gid ${APP_GROUP} --uid 1000 --shell /bin/bash --create-home ${APP_USER}

#
# 📦 Gradle Setup Stage
#
FROM base AS gradle-setup
ARG GRADLE_OPTS
ARG APP_USER
ARG APP_GROUP

# Set environment variables for Gradle
ENV GRADLE_OPTS="${GRADLE_OPTS}"

WORKDIR /build

COPY --chown=${APP_USER}:${APP_GROUP} gradle gradle/
COPY --chown=${APP_USER}:${APP_GROUP} gradlew gradlew

# Download and verify Gradle with progress bar
RUN ./gradlew --version

#
# 📚 Dependencies Stage
#
FROM gradle-setup AS dependencies
ARG APP_USER
ARG APP_GROUP

WORKDIR /build

# Copy build configuration
COPY --chown=${APP_USER}:${APP_GROUP} build.gradle.kts settings.gradle.kts ./
COPY --chown=${APP_USER}:${APP_GROUP} gradle.lockfile ./
COPY --chown=${APP_USER}:${APP_GROUP} openapi openapi/
COPY .git .git

# Generate OpenAPI stubs and download dependencies
RUN mkdir -p src/main/java && \
    chown -R ${APP_USER}:${APP_GROUP} /build && \
    chmod -R 775 /build

USER ${APP_USER}

RUN ./gradlew dependenciesBuild dependencies --no-daemon >/dev/null

#
# 🏗️ Build Stage
#
FROM dependencies AS build
ARG APP_USER
ARG APP_GROUP

# Copy source code
COPY --chown=${APP_USER}:${APP_GROUP} src src/

# Build application
RUN ./gradlew bootJar --no-daemon

#
# Python is built against the runtime's Alpine release, independently of APK's Python version.
#
FROM ${IMAGE}@sha256:${IMAGE_SHA} AS python-build
ARG PYTHON_VERSION
ARG PYTHON_SHA256

RUN apk add --no-cache \
        build-base \
        bzip2-dev \
        libffi-dev \
        linux-headers \
        openssl-dev \
        readline-dev \
        sqlite-dev \
        xz-dev \
        zlib-dev

WORKDIR /usr/src/python

RUN wget -O /tmp/python.tar.xz "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" && \
    echo "${PYTHON_SHA256}  /tmp/python.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/python.tar.xz --strip-components=1 && \
    ./configure --prefix=/opt/python --with-ensurepip=install && \
    make -j "$(nproc)" EXTRA_CFLAGS="-DTHREAD_STACK_SIZE=0x100000" && \
    make install

#
# 🚀 Runtime Stage
#
FROM ${IMAGE}@sha256:${IMAGE_SHA} AS runtime-base
ARG APP_USER
ARG APP_GROUP
ARG APP_HOME
ARG APPINSIGHTS_VERSION
ARG TZ

WORKDIR ${APP_HOME}

# Set timezone environment variable
ENV TZ=${TZ}
ENV PATH="/opt/python/bin:${PATH}"

COPY --from=python-build /opt/python /opt/python

# 🛡️ Security Setup and Timezone
RUN apk upgrade --no-cache && \
    apk add --no-cache \
        tini \
        curl \
        # Libraries added to support the manual installation of python 3.12 \
        bzip2 \
        libffi \
        libssl3 \
        readline \
        sqlite-libs \
        xz-libs \
        zlib \
        # Configure timezone + ENV=TZ \
        tzdata \
        git  && \
    # Create user and group \
    addgroup -S ${APP_GROUP} && \
    adduser -S ${APP_USER} -G ${APP_GROUP} && \
    # Install dbt-core \
    python3 -m venv .venv && \
    source .venv/bin/activate && \
    python -m ensurepip --upgrade && \
    python -m pip install "dbt-core==1.11.14" "dbt-postgres==1.11.0" && \
    dbt --version && \
    echo source .venv/bin/activate >> /etc/profile && \
    echo PATH="$PATH" >> /etc/profile && \
    chmod +x /etc/profile

ADD --chmod=644 https://github.com/microsoft/ApplicationInsights-Java/releases/download/${APPINSIGHTS_VERSION}/applicationinsights-agent-${APPINSIGHTS_VERSION}.jar ${APP_HOME}/applicationinsights-agent.jar

FROM runtime-base AS runtime
ARG APP_USER
ARG APP_GROUP
ARG APP_HOME

# Copy dbt project and scripts
COPY --chown=${APP_USER}:${APP_GROUP} p4pa_analytics_dbt dbt/
COPY --chown=${APP_USER}:${APP_GROUP} script script/
RUN chmod +x /app/script/*

# 📦 Copy Artifacts
COPY --from=build /build/build/libs/*.jar ${APP_HOME}/app.jar

# 📝 Set Permissions
RUN chown -R ${APP_USER}:${APP_GROUP} ${APP_HOME}

# 🔌 Container Configuration
EXPOSE 8080
USER ${APP_USER}

# 🎬 Startup Configuration
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["java", "-jar", "/app/app.jar"]
